# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon in production). For local runs you can use:
#   DATABASE_URL=sqlite:///./local.db
DATABASE_URL=postgresql://user:password@host/dbname

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# "development" mounts the /dev seed + reset routes (admin-only). Use "production" when deployed.
ENVIRONMENT=development

# Frontend origin used in password-reset links, and the CORS allow-list (comma-separated)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Resend API key for password-reset emails
RESEND_API_KEY=
# Sender on a domain verified in Resend (the default test sender only reaches the Resend account owner)
EMAIL_FROM=GradeIQ UPSA <no-reply@your-verified-domain.com>
